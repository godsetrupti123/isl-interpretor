    "check:browser": "node scripts/checkBrowser.mjs",
    "verify": "npm run check:vectors && npm run check:assets && npm run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^18.2.0",
